generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          String           @id @default(cuid())
  name        String
  code        String
  description String?
  imageUrl    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  variants    ProductVariant[]
}

model ProductVariant {
  id          String              @id @default(cuid())
  productId   String
  product     Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  size        String
  color       String
  colorCode   String
  quantity    Int                 @default(0)
  cost        Int                 @default(0)
  sellPrice   Int                 @default(0)
  lowStockThreshold Int            @default(2)
  notes       String?
  imageUrl    String?
  dropCode    String
  sku         String              @unique
  barcode     String              @unique
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  movements   InventoryMovement[]
  sales       Sale[]
  items       InventoryItem[]
}

model AppSettings {
  id                       String   @id @default("default")
  brandCode                String   @default("CAE")
  currency                 String   @default("USD")
  defaultLowStockThreshold Int      @default(2)
  labelWidth               String   @default("2in")
  labelHeight              String   @default("1in")
  defaultDropCode          String   @default("D001")
  updatedAt                DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  type      String
  sku       String?
  itemName  String?
  quantity  Int?
  note      String?
  createdAt DateTime @default(now())
}

model InventoryMovement {
  id        String          @id @default(cuid())
  variantId String
  variant   ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type      String
  quantity  Int
  note      String?
  createdAt DateTime        @default(now())
}

model InventoryItem {
  id         String         @id @default(cuid())
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  itemCode   String         @unique
  shortBarcodeId String?     @unique
  status     String         @default("ORDERED")
  receivedAt DateTime       @default(now())
  soldAt     DateTime?
  packedAt   DateTime?
  notes      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model Drop {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  releaseDate DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Sale {
  id           String         @id @default(cuid())
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  sku          String
  itemCode     String?        @unique
  quantity     Int
  salePrice    Int
  grossRevenue Int
  productCost  Int
  fees         Int            @default(0)
  shippingCost Int            @default(0)
  netProfit    Int
  platform     String?
  note         String?
  soldAt       DateTime
  createdAt    DateTime       @default(now())
}

model Expense {
  id        String   @id @default(cuid())
  name      String
  category  String
  amount    Int
  spentAt   DateTime
  note      String?
  createdAt DateTime @default(now())
}
